{
  "title": "ZKsync OS — Atomic DvP demo",
  "uid": "zksync-demo",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Executed swaps / second",
      "description": "During the timed DvP load, one transaction is one atomic swap containing two ERC-20 transfers. Setup transactions also appear in this counter. Final state verification is reported in the terminal.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
          "expr": "rate(execution_executed_transactions[$__rate_interval])",
          "legendFormat": "swaps/s",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 400000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Executed swaps / second",
      "description": "During the timed DvP load, one transaction is one atomic swap containing two ERC-20 transfers. Setup transactions also appear in this counter. Final state verification is reported in the terminal.",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
          "expr": "rate(execution_executed_transactions[$__rate_interval])",
          "legendFormat": "executed swaps/s",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "line" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 400000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Block height",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
          "expr": "execution_block_number",
          "legendFormat": "block",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Blocks / second",
      "gridPos": { "x": 6, "y": 8, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
          "expr": "rate(execution_block_number[$__rate_interval])",
          "legendFormat": "blocks/s",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Gas / second",
      "gridPos": { "x": 15, "y": 8, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
          "expr": "rate(execution_gas_per_block_sum[$__rate_interval])",
          "legendFormat": "gas/s",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Avg gas / block",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
          "expr": "rate(execution_gas_per_block_sum[$__rate_interval]) / rate(execution_gas_per_block_count[$__rate_interval])",
          "legendFormat": "gas/block",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Avg swaps / block",
      "description": "During the timed DvP load, one transaction is one atomic swap containing two ERC-20 transfers. Setup transactions also appear in this counter. Final state verification is reported in the terminal.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cep2ohiclks1sb" },
          "expr": "rate(execution_executed_transactions[$__rate_interval]) / rate(execution_block_number[$__rate_interval])",
          "legendFormat": "swaps/block",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    }
  ]
}
